{
  "description": "Compact export for model development that excludes raw payloads and collector internals.",
  "id": "lightweight_model_eval",
  "kind": "export_profile",
  "label": "Lightweight Model Evaluation",
  "source": "supabase.weather",
  "tables": {
    "collector_runs": {
      "include": false,
      "reason": "Collector metadata is not needed for model evaluation."
    },
    "events": {
      "protected_columns": [
        "city",
        "event_ticker",
        "target_date",
        "snapshot_time_utc"
      ],
      "required": true,
      "required_columns": [
        "climate_day_start_utc",
        "climate_day_end_utc",
        "station_id"
      ],
      "source_table": "events"
    },
    "final_temperature_labels": {
      "required": false,
      "source_table": "final_temperature_labels"
    },
    "market_snapshots": {
      "exclude_columns": [
        "raw_payload_id"
      ],
      "protected_columns": [
        "city",
        "event_ticker",
        "market_ticker",
        "target_date",
        "snapshot_time_utc"
      ],
      "required": true,
      "required_columns": [
        "bracket_index",
        "bracket_lower_f",
        "bracket_upper_f",
        "yes_bid_dollars",
        "yes_ask_dollars",
        "no_bid_dollars",
        "no_ask_dollars",
        "normalized_market_midpoint_probability"
      ],
      "source_table": "market_snapshots"
    },
    "provider_errors": {
      "include": false,
      "reason": "Provider failures are quality diagnostics, not model features."
    },
    "raw_payloads": {
      "include": false,
      "reason": "Raw payloads are large and not needed for most model evaluation."
    },
    "settlements": {
      "required": false,
      "source_table": "settlements"
    },
    "weather_snapshots": {
      "exclude_columns": [
        "raw_payload_id"
      ],
      "protected_columns": [
        "city",
        "event_ticker",
        "target_date",
        "snapshot_time_utc"
      ],
      "required": true,
      "required_columns": [
        "nws_anchor_high_f",
        "observed_high_so_far_f",
        "hrrr_projected_high_f",
        "nbm_projected_high_f",
        "ensemble_raw_median_high_f",
        "features"
      ],
      "source_table": "weather_snapshots"
    }
  },
  "version": 1
}
