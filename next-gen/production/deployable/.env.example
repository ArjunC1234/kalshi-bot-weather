NWS_USER_AGENT=kalshi-weather-production/0.1 your-email@example.com

# Collector v3 fact database and raw-payload archive.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=weather-research-raw
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
COLLECTOR_DATA_DIR=/opt/kalshi-weather-next-gen/collector_spool_v3

# Demo trading bot settings, not used by collector v3.
KALSHI_API_BASE_URL=https://demo-api.kalshi.co/trade-api/v2
KALSHI_API_KEY_ID=replace-with-demo-api-key-id
KALSHI_PRIVATE_KEY_PATH=/opt/kalshi-weather-next-gen/kalshi_private_key.pem
TRADE_ENABLED=false
