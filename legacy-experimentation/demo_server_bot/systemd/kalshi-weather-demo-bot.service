[Unit]
Description=Kalshi weather demo trading bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/kalshi-weather-demo-bot
EnvironmentFile=/opt/kalshi-weather-demo-bot/.env
ExecStart=/opt/kalshi-weather-demo-bot/.venv/bin/python /opt/kalshi-weather-demo-bot/bot.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target

